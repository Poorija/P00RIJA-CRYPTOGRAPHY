# Copy to .env next to config/docker-compose.yaml, then edit.
# Nothing here is read by the browser: the client encrypts before anything
# leaves the device, and the relay never sees a key or a plaintext message.
#
#   cp .env.example .env
#   docker compose -f config/docker-compose.yaml up -d

# ---- required: compose refuses to start without these three ----

# The name (or IP) clients will type. Certificates must match it.
DOMAIN=chat.example.com

# Monitor dashboard password, at https://DOMAIN:8585/Monitor_Server
# Twelve characters minimum. There is no recovery for this.
#
# The relay REFUSES TO START without one. It used to fall back to a compiled-in
# "admin123456" and print a warning, which is a door that opens by default on
# the control panel of a service whose whole job is to be reachable. If you
# genuinely need that behaviour — a throwaway box on a closed network — set
# ALLOW_INSECURE_DEFAULTS=1 below and it will start, loudly.
MONITOR_PASSWORD=change-me-at-least-12-characters

# Leave unset. Setting it to 1 lets the relay start with a weak or missing
# MONITOR_PASSWORD, using a password that is written in the source.
# ALLOW_INSECURE_DEFAULTS=1

# Shared secret for the bundled TURN server. Unrelated to the one above.
TURN_PASSWORD=change-me-too-a-different-long-secret

# ---- practically required in production ----

# What clients can actually reach; coturn hands this out as its relay address.
# Leave at 127.0.0.1 only for a purely local trial.
EXTERNAL_IP=203.0.113.10

# Browsers refuse WebRTC and service workers on plain HTTP. Self-signed is fine
# for a LAN or an IP; see README for the openssl one-liner.
#
# These paths are relative to config/, where docker-compose.yaml lives — that is
# where Compose resolves a relative bind mount from, not from where you ran the
# command. Written as ./certs/ they pointed at config/certs/, Docker helpfully
# created empty DIRECTORIES with those names, and nginx died on the file it was
# handed with "PEM routines::no start line", which says nothing about the real
# cause. CERTS_DIR below has always been ../certs; these now agree with it.
SSL_CERT_PATH=../certs/cert.pem
SSL_KEY_PATH=../certs/key.pem

# Origins allowed to talk to the relay. Empty means "same origin only", which
# is what you want unless you serve the client from somewhere else.
CHAT_ALLOWED_ORIGINS=https://chat.example.com:8585

# ---- background notifications (optional) ----

# Without these the relay generates a new VAPID pair on every restart, and every
# push subscription made before the restart stops working. Generate a stable
# pair once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chat.example.com

# ---- everything below has a working default; set only to override ----

# TURN username to pair with TURN_PASSWORD.
TURN_USER=change-me-a-turn-username

# Full TURN URL, if it differs from turn:DOMAIN:3478.
CHAT_TURN_URL=

# Public addresses to advertise, when the relay sits behind another proxy.
CHAT_PUBLIC_RELAY_ORIGIN=
CHAT_PUBLIC_PRESENCE_URL=

# Automatic Let's Encrypt renewal. An empty email disables the renewer.
CERTBOT_EMAIL=
CERTS_DIR=../certs
CERT_RENEW_BEFORE_DAYS=30
CERT_CHECK_INTERVAL_SECONDS=21600

# UID coturn drops to inside its container.
COTURN_KEY_UID=65534
