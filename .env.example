# Copy to .env next to config/docker-compose.yaml, then edit.
# Nothing here is read by the browser: the client encrypts before anything
# leaves the device, and the relay never sees a key or a plaintext message.
#
#   cp .env.example .env
#   docker compose -f config/docker-compose.yaml up -d

# ---- required: compose refuses to start without these three ----

# The name (or IP) clients will type. Certificates must match it.
DOMAIN=chat.example.com

# Monitor dashboard password, at https://DOMAIN:8585/Monitor_Server
# Twelve characters minimum. There is no recovery for this.
#
# The relay REFUSES TO START without one. It used to fall back to a compiled-in
# "admin123456" and print a warning, which is a door that opens by default on
# the control panel of a service whose whole job is to be reachable. If you
# genuinely need that behaviour — a throwaway box on a closed network — set
# ALLOW_INSECURE_DEFAULTS=1 below and it will start, loudly.
MONITOR_PASSWORD=change-me-at-least-12-characters

# Leave unset. Setting it to 1 lets the relay start with a weak or missing
# MONITOR_PASSWORD, using a password that is written in the source.
# ALLOW_INSECURE_DEFAULTS=1

# Shared secret for the bundled TURN server. Unrelated to the one above.
TURN_PASSWORD=change-me-too-a-different-long-secret

# TURN REST secret shared by coturn and the relay (64 hex characters:
# `openssl rand -hex 32`). With it, /turn-config hands each client a
# credential that expires instead of the static TURN_USER/TURN_PASSWORD pair,
# so the TURN server is no longer an open relay for anyone who can fetch a
# JSON file. scripts/sync-to-server.sh adds one to an .env that lacks it.
TURN_SECRET=

# ---- practically required in production ----

# What clients can actually reach; coturn hands this out as its relay address.
# Leave at 127.0.0.1 only for a purely local trial.
EXTERNAL_IP=203.0.113.10

# Browsers refuse WebRTC and service workers on plain HTTP. Self-signed is fine
# for a LAN or an IP; see README for the openssl one-liner.
#
# These paths are relative to config/, where docker-compose.yaml lives — that is
# where Compose resolves a relative bind mount from, not from where you ran the
# command. Written as ./certs/ they pointed at config/certs/, Docker helpfully
# created empty DIRECTORIES with those names, and nginx died on the file it was
# handed with "PEM routines::no start line", which says nothing about the real
# cause. CERTS_DIR below has always been ../certs; these now agree with it.
SSL_CERT_PATH=../certs/cert.pem
SSL_KEY_PATH=../certs/key.pem
# Since 2.98.36 these follow from the folder below and may be left out:
# SSL_CERT_PATH defaults to CERTS_DIR/CERT_FILE, SSL_KEY_PATH to CERTS_DIR/KEY_FILE.

# Origins allowed to talk to the relay. Empty means "same origin only", which
# is what you want unless you serve the client from somewhere else.
CHAT_ALLOWED_ORIGINS=https://chat.example.com:8585

# ---- background notifications (optional) ----

# Without these the relay generates a new VAPID pair on every restart, and every
# push subscription made before the restart stops working. Generate a stable
# pair once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chat.example.com

# ---- everything below has a working default; set only to override ----

# TURN username to pair with TURN_PASSWORD. Required: coturn will not start
# without it, and the relay hands it to clients through /turn-config.
TURN_USER=change-me-a-turn-username

# Full TURN URL, if it differs from turn:DOMAIN:3478.
CHAT_TURN_URL=

# Where this relay keeps the X25519 key it is named by. The default is
# relay-identity.json beside the other server state, which is right for almost
# everyone. Set it only when the identity has to live somewhere the rest of
# the data does not — and keep it: a relay that loses this file gets a new
# name, and every client that pinned the old one reports the change.
CHAT_RELAY_IDENTITY_PATH=

# ---- transit between relays -------------------------------------------
# Other relays this one will hand traffic to, and take it from. Empty is the
# default and means transit is off: a relay that carried for anyone who asked
# would be an open relay, and this arrangement is between operators who have
# already agreed with each other.
#
# Each entry is  <relay id>@<origin>  — the id is what the other relay's
# /relay-identity reports, and the address is only how to get there. A bare id
# with no address is a relay this one will ANSWER but never dial, which is the
# setting for a peer that sits behind a firewall and calls out.
#
#   CHAT_TRANSIT_PEERS=<64 hex chars>@https://relay.example.de
#
CHAT_TRANSIT_PEERS=
# Relay family (docs/RELAY-NETWORK.md, "Relay families"): the operator key
# this relay trusts (SPKI base64; scripts/deploy.sh writes it), where a new
# relay asks for the family's directory, and the lowest serial it takes.
CHAT_OPERATOR_KEY=
CHAT_DIRECTORY_SOURCES=
CHAT_DIRECTORY_MIN_SERIAL=0
# Linking with other operators (docs/RELAY-NETWORK.md): how long a gateway's
# link must stand before it carries again, how long a gateway taken off keeps
# its partner links, and the limits on join requests.
CHAT_GATEWAY_STABLE_MS=60000
CHAT_GATEWAY_HANDOFF_MS=120000
CHAT_JOIN_PER_HOUR=10
CHAT_JOIN_WAITING_MAX=20
# The central panel (docs/MONITOR-SERVER.md): 1 takes dangerous dashboard actions
# only with an operator or admin signature; 0 refuses the panel's signed requests.
CHAT_REQUIRE_OPERATOR_SIGNATURE=0
CHAT_CENTRAL_CONTROL=1

# Set to 1 to skip certificate verification when reaching a transit peer, for
# two relays whose operator signed their own. Less alarming than it sounds and
# still not the default: the link is authenticated by relay identity whatever
# the transport says, so the certificate is defence in depth rather than the
# control. It changes nothing about how clients reach this relay.
CHAT_TRANSIT_INSECURE_TLS=

# Public addresses to advertise, when the relay sits behind another proxy.
CHAT_PUBLIC_RELAY_ORIGIN=
CHAT_PUBLIC_PRESENCE_URL=

# The certificate: one folder, read in place by nginx, the TURN server and the
# relay — and by anything else on the machine that serves the same name, such
# as 3X-UI, which reads /root/cert/<domain>/ (fullchain.pem, privkey.pem). The
# cert-renewer container keeps it (scripts/cert-renewer.sh):
#   letsencrypt  issues it for DOMAIN — a name, or a public IP address on Let's
#                Encrypt's six-day profile — renews it when
#                CERT_RENEW_BEFORE_DAYS are left (a third of its life for a
#                six-day one), writes it into the folder and restarts what
#                reads it, 3X-UI included when 3X-UI reads this folder. An
#                acme.sh entry renewing into the same folder is set aside
#                (renamed .conf.removed), so the folder has one owner;
#   existing     someone else renews it; the stack restarts when it changes
#                and warns as the expiry nears;
#   self-signed  made here for localhost, DOMAIN, EXTERNAL_IP, CERT_SANS and
#                every address the machine has, and made again before it ends.
# Empty: letsencrypt for a domain name, self-signed for localhost or an address.
# An empty email still works — the account is registered without one.
CERT_MODE=
CERTS_DIR=../certs
CERT_FILE=cert.pem
KEY_FILE=key.pem
CERT_SANS=
CERTBOT_EMAIL=
CERT_RENEW_BEFORE_DAYS=10
CERT_CHECK_INTERVAL_SECONDS=21600

# UID coturn drops to inside its container.
COTURN_KEY_UID=65534

# ---- other addresses of this relay (optional) ----
# A second domain, or a CDN in front of this server, for clients whose way to
# DOMAIN is blocked. Clients learn the list from /relay-mirrors and switch to a
# mirror only after it proves it holds this relay's key; they switch back as
# soon as the main address answers again. Separate with spaces or commas.
# Each mirror must reach this server's port with a certificate valid for its
# name (a CDN in "full" TLS mode does this). See docs/RELAY-NETWORK.md.
CHAT_MIRROR_ORIGINS=

# ---- where the relay's plain ports listen ----
# The relay speaks plain HTTP on 9000 (and 9001, 9080); nginx in front of it
# carries TLS. These ports answer only this machine and nginx — loopback and
# the Docker bridge (docker0 stands for its address) — never the internet.
# Leave it unless your Docker bridge has another name.
CHAT_LISTEN_HOSTS=127.0.0.1,docker0

# ---- a front door for a relay people cannot reach (optional) ----
# When TLS to a relay is blocked on the way in (measured for a relay inside
# Iran, seen from outside: the handshake completes and nothing follows) but
# that relay can still reach out, a relay people CAN reach answers for it at
# an address of its own, carrying each connection over the transit link the
# hidden relay dials. Clients prove the door leads to the relay they pinned
# before using it. See docs/RELAY-NETWORK.md, "A front door".
#   On the reachable relay:  CHAT_FRONTS=<hidden relay id>@https://<this domain>:8586
#                            APP_FRONT_BIND=0.0.0.0  (publishes APP_FRONT_PORT, 8586)
#   On the hidden relay:     CHAT_FRONT_DOORS=<reachable relay id>
#                            CHAT_MIRROR_ORIGINS=https://<reachable domain>:8586
#                            CHAT_ALLOWED_ORIGINS=... plus the reachable relay's
#                            own https origins, whose page will call it
CHAT_FRONTS=
CHAT_FRONT_DOORS=
APP_FRONT_BIND=127.0.0.1
APP_FRONT_PORT=8586

# ---- link previews for the web and phone apps ----
# The desktop app fetches a link's preview itself. The web app and the phone
# apps cannot, so they ask this relay (POST /link-preview): it opens the page
# — public addresses only, no redirect to another site, size and time capped —
# and keeps nothing. The relay therefore sees links people choose to preview;
# the app says so beside the switch, which is off until a person turns it on.
# 0 turns the endpoint off and the switch disappears from those apps.
CHAT_LINK_PREVIEWS=1

# Importing a Telegram sticker pack from its share link (t.me/addstickers/…).
# Telegram hands a pack out only through its Bot API, so the relay needs a bot
# token: create a bot with @BotFather, and put its token here. The token stays
# on this server; Telegram sees this server's address, not the person's.
# A relay that cannot reach Telegram (inside a network that blocks it) leaves
# the token empty and names, instead, a relay that has one:
#   TELEGRAM_STICKERS_UPSTREAM=https://relay-outside.example:8585
# Both empty: the app says importing from a link is not available here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_STICKERS_UPSTREAM=
