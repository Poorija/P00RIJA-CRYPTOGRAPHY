if (chatState.typingTimers.has(key)) {
clearTimeout(chatState.typingTimers.get(key));
}
const timer = setTimeout(() => {
chatState.typingTimers.delete(key);
renderActivePeer();
}, 4000);
chatState.typingTimers.set(key, timer);
