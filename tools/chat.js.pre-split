}
function clearPeerHealTimers() {
if (chatState.peerHealTimer) {
clearTimeout(chatState.peerHealTimer);
chatState.peerHealTimer = null;
}
if (chatState.peerVerifyTimer) {
clearTimeout(chatState.peerVerifyTimer);
