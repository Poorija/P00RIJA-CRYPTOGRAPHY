return false;
}
}
function restrictionHeaders() {
const headers = {
'X-P00RIJA-Fingerprint': chatState.identity?.fingerprint || '',
'X-P00RIJA-Peer-Id': chatState.peerId || chatState.profile.stablePeerId || '',
'X-P00RIJA-Client-Id': chatState.clientId || '',
