function normalizeMessageReactions(entry) {
if (!entry) return {};
if (entry.reactions && typeof entry.reactions === 'object' && !Array.isArray(entry.reactions)) {
return { ...entry.reactions };
}
if (entry.reaction) {
return { legacy: entry.reaction };
}
