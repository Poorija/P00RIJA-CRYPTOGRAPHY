name: '',
serverUrl: '',
presenceUrl: '',
peerOrigin: '',
autoConnect: true,
allowVideo: true,
autoDiscovery: true,
showSuspensionCountdown: true,
avatarData: '',
stablePeerId: '',
turnUrl: '',
turnUsername: '',
turnCredential: '',
/* null = decide from whether a TURN server is configured; see peerOptions(). */
publicStun: null,
