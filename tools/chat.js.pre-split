messageToneId: 'chime',
},
identity: null,
history: {},
sessionKeys: {},
spaces: {
groups: [],
channels: [],
},
calls: [],
peers: [],
stickerPacks: [],
stickerActivePackId: '',
stickerManageMode: false,
